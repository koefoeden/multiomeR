flowchart TB
  classDef regular_input fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a;
  classDef CFG_input fill:#f3e8ff,stroke:#8b5cf6,color:#6d28d9;
  classDef intermediate_object fill:#f8fafc,stroke:#64748b,color:#1f2937;
  classDef regular_output fill:#ecfdf5,stroke:#10b981,color:#065f46;
  classDef QC_output fill:#fff7ed,stroke:#f97316,color:#9a3412;
  classDef optional_regular_input fill:#dbeafe,stroke:#3b82f6,stroke-dasharray: 5 5,color:#1e3a8a;
  classDef optional_intermediate_object fill:#f8fafc,stroke:#64748b,stroke-dasharray: 5 5,color:#1f2937;
  classDef optional_regular_output fill:#ecfdf5,stroke:#10b981,stroke-dasharray: 5 5,color:#065f46;
  classDef junction_node fill:none,stroke:none,color:#334155,font-weight:bold;

  WNNMetadata("Final WNN metadata<br/>(metadata_w_cell_types_tibble.WNN)")
  AggregatedGEX("Aggregated GEX BPCells matrix<br/>(aggregated_counts_BPCells_matrix.GEX)")
  ATACPeakMatrix("QC-filtered ATAC peak matrix<br/>(peak_QC_filtered_BPCells_matrix.ATAC)")
  SubgroupConfig("Subgroup settings<br/>(aggregation_subgroups_*)")
  MarkerGenes("Marker gene sets<br/>(aggregation_GEX_marker_genes)")

  SelectedSubgroups("Eligible subgroup labels<br/>(subgroups_to_process_vec)")
  SubgroupMetadata("Per-subgroup metadata<br/>(metadata_tibble.subgroups)")
  GEXPCA("Subgroup GEX PCA<br/>(PCA_BPCells.GEX.subgroups)")
  GEXHarmony("Subgroup GEX Harmony embeddings<br/>(harmony_embeddings_matrix.GEX.subgroups)")
  ATACLSI("Subgroup ATAC LSI<br/>(LSI_BPCells.ATAC.subgroups)")
  ATACHarmony("Subgroup ATAC Harmony embeddings<br/>(harmony_embeddings_matrix.ATAC.subgroups)")
  WNNResults("Subgroup WNN graph<br/>(WNN_results.subgroups)")
  ClusteredMetadata("Subgroup cluster metadata<br/>(metadata_w_clusters_tibble.subgroups)")
  FilteredMetadata("Filtered subgroup metadata<br/>(metadata_w_clusters_tibble_filtered.subgroups)")
  MarkerTables("Subgroup marker tables<br/>(marker_tibbles.subgroups)")
  CategoricalUMAPs("Categorical subgroup UMAPs<br/>(categorical.UMAPs.subgroups)")
  ContinuousUMAPs("Continuous subgroup UMAPs<br/>(continuous.UMAPs.subgroups)")
  VolcanoPlots("Marker volcano plots<br/>(marker_volcano_plots.subgroups)")

  WNNMetadata --- PickSubgroups
  SubgroupConfig --- PickSubgroups
  PickSubgroups["Count cells and keep sufficiently large labels"]
  PickSubgroups --> SelectedSubgroups

  WNNMetadata --- SliceSubgroups
  SelectedSubgroups --- SliceSubgroups
  SubgroupConfig --- SliceSubgroups
  SliceSubgroups["Subset final metadata by subgroup label"]
  SliceSubgroups --> SubgroupMetadata

  AggregatedGEX --- RunGEX
  SubgroupMetadata --- RunGEX
  RunGEX["Recompute SCTransform PCA and Harmony"]
  RunGEX --> GEXPCA
  GEXPCA --> GEXHarmony

  ATACPeakMatrix --- RunATAC
  SubgroupMetadata --- RunATAC
  RunATAC["Recompute ATAC LSI and Harmony"]
  RunATAC --> ATACLSI
  ATACLSI --> ATACHarmony

  GEXHarmony --- BuildWNN
  ATACHarmony --- BuildWNN
  SubgroupMetadata --- BuildWNN
  BuildWNN["Build subgroup-native WNN graph"]
  BuildWNN --> WNNResults
  WNNResults -->|UMAP, clustering, and modality weights| ClusteredMetadata

  ClusteredMetadata --- RefineSubgroups
  MarkerGenes --- RefineSubgroups
  RefineSubgroups["Score marker agreement and filter contaminated clusters"]
  RefineSubgroups --> FilteredMetadata

  FilteredMetadata -->|Find BPCells markers| MarkerTables
  FilteredMetadata --> CategoricalUMAPs
  FilteredMetadata --> ContinuousUMAPs
  MarkerTables --> VolcanoPlots

  class WNNMetadata,AggregatedGEX,ATACPeakMatrix regular_input;
  class SubgroupConfig,MarkerGenes CFG_input;
  class SelectedSubgroups,SubgroupMetadata,GEXPCA,GEXHarmony,ATACLSI,ATACHarmony,WNNResults,ClusteredMetadata,FilteredMetadata,MarkerTables intermediate_object;
  class CategoricalUMAPs,ContinuousUMAPs,VolcanoPlots QC_output;
  class PickSubgroups,SliceSubgroups,RunGEX,RunATAC,BuildWNN,RefineSubgroups junction_node;
