  AggregatedGEX("Aggregated GEX matrix<br/>(aggregated_counts_BPCells_matrix.GEX)")
  MetadataInputs("Reaction and donor metadata<br/>(metadata_tibble.GEX inputs)")
  GEXMetadata("GEX metadata<br/>(metadata_tibble.GEX)")
  GEXPCA("GEX PCA<br/>(PCA_BPCells.GEX)")
  GEXHarmony("Corrected GEX embedding<br/>(harmony_embeddings_matrix.GEX)")
  GEXClusters("GEX clusters and UMAP<br/>(metadata_w_clusters_tibble.GEX)")
  GEXCellTypes("Cell-typed GEX metadata<br/>(metadata_w_cell_types_tibble.GEX)")
  GEXOutputs("GEX marker and QC outputs<br/>(markers and QC plots)")

  MetadataInputs -->|join metadata| GEXMetadata
  AggregatedGEX -->|SCTransform residual PCA| GEXPCA
  GEXMetadata -->|batch covariates| GEXPCA
  GEXPCA -->|Harmony| GEXHarmony
  GEXHarmony -->|SNN clustering + UMAP| GEXClusters
  GEXClusters -->|cell-type annotation| GEXCellTypes
  GEXCellTypes -->|markers and QC plots| GEXOutputs

  class AggregatedGEX,MetadataInputs regular_input;
  class GEXMetadata,GEXPCA,GEXHarmony,GEXClusters intermediate_object;
  class GEXCellTypes regular_output;
  class GEXOutputs QC_output;
