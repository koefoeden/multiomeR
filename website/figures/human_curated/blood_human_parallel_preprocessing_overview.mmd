%%{init: {'layout': 'elk'}}%%
flowchart TB
  classDef regular_input fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a;
  classDef CFG_input fill:#f3e8ff,stroke:#8b5cf6,color:#6d28d9;
  classDef intermediate_object fill:#f8fafc,stroke:#64748b,color:#1f2937;
  classDef regular_output fill:#ecfdf5,stroke:#10b981,color:#065f46;
  classDef QC_output fill:#fff7ed,stroke:#f97316,color:#9a3412;
  classDef optional_regular_input fill:#dbeafe,stroke:#3b82f6,stroke-dasharray: 5 5,color:#1e3a8a;
  classDef optional_intermediate_object fill:#f8fafc,stroke:#64748b,stroke-dasharray: 5 5,color:#1f2937;
  classDef optional_regular_output fill:#ecfdf5,stroke:#10b981,stroke-dasharray: 5 5,color:#065f46;
  classDef junction_node fill:none,stroke:none,color:#334155,font-weight:bold;

  CellRangerOutputs("Per-reaction Cell Ranger outputs<br/>(cellranger_summary_file)")
  ReferenceMetadata("Reference and feature metadata<br/>(gene_features_df)")
  CellBarcodes("Cell barcode list<br/>(cellranger_barcodes_tsv)")
  ReactionGEX("Reaction GEX matrix<br/>(GEX_counts_BPCells_matrix)")
  ReactionFragments("Reaction ATAC fragments<br/>(fragments_w_prefix_bpcells)")
  CellRangerMetrics("Cell Ranger cell metrics<br/>(per_barcode_metrics_tibble)")
  GEXQCMetrics("GEX QC metrics<br/>(GEX_basic_metadata_tibble)")
  ATACQCMetrics("ATAC QC metrics<br/>(ATAC_qc_metrics_tibble)")
  GenotypeDoubletMetrics("Genotype and doublet metrics<br/>(cellsnp/vireo/amulet)")
  FullMetadata("Full reaction metadata<br/>(full_metadata_tibble)")
  KeptMetadata("QC-kept reaction metadata<br/>(cellranger_kept_metadata_tibble)")
  ExclusionSummaries("Exclusion lists and QC plots<br/>(excluded_barcodes_by_type)")

  CellRangerOutputs -->|extract barcodes| CellBarcodes
  CellRangerOutputs -->|read feature and reference metadata| ReferenceMetadata
  CellRangerOutputs -->|CellBender or Cell Ranger to BPCells| ReactionGEX
  ReferenceMetadata -->|align gene features| ReactionGEX
  CellRangerOutputs -->|prefix fragment barcodes| ReactionFragments
  ReactionGEX -->|count and feature QC| GEXQCMetrics
  ReactionFragments -->|TSS and nucleosome QC| ATACQCMetrics
  ReferenceMetadata -->|gene annotation| ATACQCMetrics
  CellRangerOutputs -->|per-barcode metrics| CellRangerMetrics
  CellBarcodes -->|AMULET, cellsnp-lite, vireo| GenotypeDoubletMetrics
  CellRangerOutputs -->|fragments and BAM inputs| GenotypeDoubletMetrics
  GEXQCMetrics -->|combine metadata| FullMetadata
  ATACQCMetrics -->|combine metadata| FullMetadata
  CellRangerMetrics -->|combine metadata| FullMetadata
  GenotypeDoubletMetrics -->|combine metadata| FullMetadata
  FullMetadata -->|apply QC filters| KeptMetadata
  FullMetadata -->|summarize excluded barcodes| ExclusionSummaries
  KeptMetadata -->|Cell Ranger-only exclusions| ExclusionSummaries

  class CellRangerOutputs,ReferenceMetadata regular_input;
  class CellBarcodes,CellRangerMetrics,GEXQCMetrics,ATACQCMetrics,GenotypeDoubletMetrics,FullMetadata intermediate_object;
  class ReactionGEX,ReactionFragments,KeptMetadata regular_output;
  class ExclusionSummaries QC_output;
