#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: dev/worktree_teardown [--apply]

Run from an experiment worktree. Dry-runs by default. With --apply, removes
the linked git worktree and releases its scratch-store active marker after
verifying that code and outputs have already been merged/promoted.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

read_record() {
  awk -F '\t' -v key="$1" '$1 == key {print $2; exit}' "$record"
}

active_targets_process() {
  local store=$1
  local process_file=$store/meta/process
  local pid
  [ -f "$process_file" ] || return 1
  pid=$(awk -F '|' '$1 == "pid" {print $2; exit}' "$process_file")
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

release_scratch_marker() {
  if [ -f "$active_marker" ] && [ "$(sed -n '1p' "$active_marker")" = "$worktree" ]; then
    rm -f "$active_marker"
  fi
}

apply=false
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
elif [ "${1:-}" = "--apply" ]; then
  apply=true
  shift
fi
[ "$#" -eq 0 ] || die "Unexpected argument(s): $*"

worktree=$(git rev-parse --show-toplevel)
worktree=$(cd "$worktree" && pwd -P)
record=$worktree/outputs/.worktree/setup.tsv
[ -f "$record" ] || die "Missing worktree record: $record"

base=$(read_record base)
recorded_worktree=$(read_record worktree)
scratch=$(read_record scratch)
branch=$(read_record branch)
active_marker=$scratch/.worktree_active

[ "$worktree" = "$recorded_worktree" ] || die "Current checkout is not the recorded worktree: $recorded_worktree"
[ -d "$base/.git" ] || die "Base checkout not found: $base"
[ -d "$base/outputs" ] || die "Base outputs store not found: $base/outputs"
[ -d "$scratch" ] || die "Scratch store not found: $scratch"

[ -z "$(git -C "$worktree" status --porcelain)" ] || die "Worktree has uncommitted Git changes."
git -C "$base" merge-base --is-ancestor "$branch" HEAD ||
  die "Branch is not merged into base HEAD: $branch"

sha256sum -c "$worktree/outputs/.worktree/base_outputs_meta.sha256" >/dev/null ||
  die "Recorded base outputs metadata checksum does not match current base."
cmp -s "$base/outputs/meta/meta" "$worktree/outputs/meta/meta" ||
  die "Base and worktree outputs/meta/meta differ; promote outputs before teardown."

active_targets_process "$base/outputs" &&
  die "Base targets process appears active: $base/outputs/meta/process"
active_targets_process "$worktree/outputs" &&
  die "Worktree targets process appears active: $worktree/outputs/meta/process"

cat <<EOF
Teardown is safe.

  worktree: $worktree
  scratch:  $scratch
  branch:   $branch

EOF

if [ "$apply" = true ]; then
  cd "$base"
  git worktree remove --force "$worktree" || {
    if git worktree list --porcelain | grep -Fxq "worktree $worktree"; then
      exit 1
    fi
    release_scratch_marker
    rm -rf "$worktree" ||
      die "Git worktree was unregistered and scratch was released, but the physical directory remains: $worktree"
  }
  release_scratch_marker
  echo "Removed worktree and released scratch marker."
else
  cat <<EOF
Dry run. Re-run with --apply to remove the linked worktree.

This does not delete the scratch store:
  $scratch

EOF
fi
