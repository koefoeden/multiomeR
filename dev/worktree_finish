#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: dev/worktree_finish [--apply] [git merge options]

Convenience wrapper run from an experiment worktree. Calls:
  dev/worktree_merge [git merge options]
  dev/worktree_promote [--apply]
USAGE
}

apply_arg=()
merge_args=()
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --apply)
      apply_arg=(--apply)
      ;;
    *)
      merge_args+=("$arg")
      ;;
  esac
done

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
"$script_dir/worktree_merge" "${merge_args[@]}"
"$script_dir/worktree_promote" "${apply_arg[@]}"
