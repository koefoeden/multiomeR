flowchart TB
  classDef regular_input fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a;
  classDef CFG_input fill:#f3e8ff,stroke:#8b5cf6,color:#6d28d9;
  classDef intermediate_object fill:#f8fafc,stroke:#64748b,color:#1f2937;
  classDef regular_output fill:#ecfdf5,stroke:#10b981,color:#065f46;
  classDef QC_output fill:#fff7ed,stroke:#f97316,color:#9a3412;
  classDef optional_regular_input fill:#dbeafe,stroke:#3b82f6,stroke-dasharray: 5 5,color:#1e3a8a;
  classDef optional_intermediate_object fill:#f8fafc,stroke:#64748b,stroke-dasharray: 5 5,color:#1f2937;
  classDef optional_regular_output fill:#ecfdf5,stroke:#10b981,stroke-dasharray: 5 5,color:#065f46;
  classDef junction_node fill:none,stroke:none,color:#334155,font-weight:bold;

  subgraph ReactionInputs["Configured reactions"]
    direction TB
    ReactionGEXMatrices("Per-reaction GEX BPCells matrices<br/>(GEX_counts_BPCells_matrix)")
    ReactionMetadata("Per-reaction metadata tibbles<br/>(cellranger_kept_metadata_tibble)")
  end

  MarkerGenes("Marker gene sets<br/>(cfg_GEX_marker_genes)")
  DonorMetadata("Donor metadata TSV<br/>(aggregation_donor_id_metadata_tsv)")
  ReactionMetadataTSV("Reaction metadata TSV<br/>(aggregation_reaction_ID_metadata_tsv)")

  AggregatedGEX("Aggregated GEX BPCells matrix<br/>(aggregated_counts_BPCells_matrix.GEX)")
  GEXMetadata("GEX metadata tibble<br/>(metadata_tibble.GEX)")
  GEXPCA("GEX PCA result<br/>(PCA_BPCells.GEX)")
  HarmonyGEX("Harmony-corrected GEX embeddings<br/>(harmony_embeddings_matrix.GEX)")
  GEXClusterMetadata("GEX clusters and UMAP metadata<br/>(metadata_w_clusters_tibble.GEX)")
  CellTypedGEX("Cell-typed GEX metadata<br/>(metadata_w_cell_types_tibble.GEX)")

  GEXMetadataOutput("Cell-level metadata table<br/>(metadata_w_cell_types_tibble.GEX)")
  GEXMarkerTables("BPCells marker tables<br/>(SNN_cluster_marker_tibbles.GEX)")
  GEXPCAPlots("PCA and feature-selection plots<br/>(PCA_*_plot.GEX)")
  GEXEmbeddingPlots("UMAP, cluster, and marker plots<br/>(categorical.UMAPs.GEX)")

  ReactionGEXMatrices -->|Combine matrices| AggregatedGEX
  ReactionMetadata --- BuildMetadata
  DonorMetadata --- BuildMetadata
  ReactionMetadataTSV --- BuildMetadata
  BuildMetadata["Join metadata"]
  BuildMetadata --> GEXMetadata

  AggregatedGEX --- RunPCA
  GEXMetadata --- RunPCA
  RunPCA["SCTransform residual PCA"]
  RunPCA --> GEXPCA
  GEXPCA -->|Harmony correction| HarmonyGEX
  HarmonyGEX -->|BPCells nearest-neighbour graph, Leiden clustering, UMAP| GEXClusterMetadata

  GEXClusterMetadata --- AddCellTypes
  AggregatedGEX --- AddCellTypes
  MarkerGenes --- AddCellTypes
  AddCellTypes["Marker-module scoring"]
  AddCellTypes --> CellTypedGEX
  CellTypedGEX -->|Per-reaction scDblFinder filtering| GEXMetadataOutput

  GEXMetadataOutput --> GEXMarkerTables
  GEXPCA --> GEXPCAPlots
  GEXMetadataOutput --> GEXEmbeddingPlots

  class ReactionGEXMatrices,ReactionMetadata,DonorMetadata,ReactionMetadataTSV regular_input;
  class MarkerGenes CFG_input;
  class AggregatedGEX,GEXMetadata,GEXPCA,HarmonyGEX,GEXClusterMetadata,CellTypedGEX intermediate_object;
  class GEXMetadataOutput,GEXMarkerTables regular_output;
  class GEXPCAPlots,GEXEmbeddingPlots QC_output;
  class BuildMetadata,RunPCA,AddCellTypes junction_node;
