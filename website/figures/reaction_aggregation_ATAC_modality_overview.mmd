flowchart TB
  classDef regular_input fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a;
  classDef CFG_input fill:#f3e8ff,stroke:#8b5cf6,color:#6d28d9;
  classDef intermediate_object fill:#f8fafc,stroke:#64748b,color:#1f2937;
  classDef regular_output fill:#ecfdf5,stroke:#10b981,color:#065f46;
  classDef QC_output fill:#fff7ed,stroke:#f97316,color:#9a3412;
  classDef optional_regular_input fill:#dbeafe,stroke:#3b82f6,stroke-dasharray: 5 5,color:#1e3a8a;
  classDef optional_intermediate_object fill:#f8fafc,stroke:#64748b,stroke-dasharray: 5 5,color:#1f2937;
  classDef optional_regular_output fill:#ecfdf5,stroke:#10b981,stroke-dasharray: 5 5,color:#065f46;
  classDef junction_node fill:none,stroke:none,color:#334155,font-weight:bold;

  CellTypedGEX("Cell-typed GEX metadata<br/>(metadata_w_cell_types_tibble.GEX)")
  GEXEmbeddings("GEX Harmony embeddings<br/>(harmony_embeddings_matrix.GEX)")
  FragmentDirs("Per-reaction BPCells fragments<br/>(fragment_BPCells_dirs_per_reaction.ATAC)")
  ClusterBarcodes("Peak-calling barcode sets<br/>(BCs_per_peak_cluster_list.ATAC)")
  PeakAnnotations("Peak annotation resources<br/>(blacklist_GRanges.ATAC)")
  MarkerGenes("Marker gene and TF sets<br/>(cfg_GEX_marker_genes, cfg_ATAC_marker_TFs)")
  MotifMatrices("TF motif matrices<br/>(peak_TF_motif_matrix.ATAC)")

  CombinedFragments("Combined BPCells fragments<br/>(combined_BPCells_fragment_obj.ATAC)")
  ClusterPeaks("Per-cluster peak sets<br/>(within_clusters_collapsed_peaks_per_cluster_GRanges.ATAC)")
  ConsensusPeaks("Consensus peaks<br/>(consensus_peak_GRanges.ATAC)")
  PeakMatrix("Consensus peak BPCells matrix<br/>(consensus_peak_BPCells_matrix.ATAC)")
  ATACMetadata("Cell-typed ATAC metadata<br/>(metadata_w_cell_types_tibble.ATAC)")
  ATACEmbeddings("ATAC LSI and Harmony embeddings<br/>(harmony_embeddings_matrix.ATAC)")
  TFActivity("TF activity BPCells matrix<br/>(TF_activity_BPCells_matrix.ATAC)")
  WNNResults("WNN graph and modality weights<br/>(WNN_results)")
  WNNMetadata("Final WNN metadata<br/>(metadata_w_cell_types_tibble.WNN)")

  ATACQC("ATAC QC and embedding plots<br/>(ATAC_QC_excluded_upset)")
  WNNUMAPs("WNN UMAP plots<br/>(categorical.UMAPs.WNN)")
  WNNWeights("ATAC vs RNA weight plots<br/>(ATAC_vs_RNA_weight_boxplots_plot.WNN)")
  WNNDiagnostics("WNN cluster diagnostics<br/>(confusion_matrices_plots.WNN)")
  WNNMarkers("WNN marker plots<br/>(markers_violin_plot.WNN)")

  FragmentDirs -->|Merge fragments| CombinedFragments
  CombinedFragments --- CallPeaks
  ClusterBarcodes --- CallPeaks
  PeakAnnotations --- CallPeaks
  CallPeaks["Split fragments and call peaks"]
  CallPeaks --> ClusterPeaks
  ClusterPeaks -->|Collapse peaks| ConsensusPeaks
  ConsensusPeaks --- CountPeaks
  CombinedFragments --- CountPeaks
  CountPeaks["Count peaks with BPCells"]
  CountPeaks --> PeakMatrix

  CellTypedGEX --- ProcessATAC
  PeakMatrix --- ProcessATAC
  MarkerGenes --- ProcessATAC
  ProcessATAC["ATAC QC, LSI, clustering, and cell typing"]
  ProcessATAC --> ATACMetadata
  ProcessATAC --> ATACEmbeddings
  ATACMetadata --> ATACQC

  ATACMetadata --- RunChromVAR
  PeakMatrix --- RunChromVAR
  MotifMatrices --- RunChromVAR
  RunChromVAR["chromVAR and TF activity"]
  RunChromVAR --> TFActivity

  GEXEmbeddings --- BuildWNN
  ATACEmbeddings --- BuildWNN
  ATACMetadata --- BuildWNN
  BuildWNN["Weighted nearest neighbours"]
  BuildWNN --> WNNResults
  WNNResults --- AddWNNMetadata
  MarkerGenes --- AddWNNMetadata
  AddWNNMetadata["WNN UMAP, clustering, and cell typing"]
  AddWNNMetadata --> WNNMetadata

  WNNMetadata --> WNNUMAPs
  WNNMetadata --> WNNWeights
  WNNMetadata --> WNNDiagnostics
  WNNMetadata --> WNNMarkers

  class CellTypedGEX,GEXEmbeddings,FragmentDirs,ClusterBarcodes,PeakAnnotations,MotifMatrices regular_input;
  class MarkerGenes CFG_input;
  class CombinedFragments,ClusterPeaks,ConsensusPeaks,PeakMatrix,ATACMetadata,ATACEmbeddings,TFActivity,WNNResults intermediate_object;
  class WNNMetadata regular_output;
  class ATACQC,WNNUMAPs,WNNWeights,WNNDiagnostics,WNNMarkers QC_output;
  class CallPeaks,CountPeaks,ProcessATAC,RunChromVAR,BuildWNN,AddWNNMetadata junction_node;
