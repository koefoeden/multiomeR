flowchart TB
  classDef regular_input fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a;
  classDef CFG_input fill:#f3e8ff,stroke:#8b5cf6,color:#6d28d9;
  classDef intermediate_object fill:#f8fafc,stroke:#64748b,color:#1f2937;
  classDef regular_output fill:#ecfdf5,stroke:#10b981,color:#065f46;
  classDef QC_output fill:#fff7ed,stroke:#f97316,color:#9a3412;
  classDef optional_regular_input fill:#dbeafe,stroke:#3b82f6,stroke-dasharray: 5 5,color:#1e3a8a;
  classDef optional_intermediate_object fill:#f8fafc,stroke:#64748b,stroke-dasharray: 5 5,color:#1f2937;
  classDef optional_regular_output fill:#ecfdf5,stroke:#10b981,stroke-dasharray: 5 5,color:#065f46;
  classDef junction_node fill:none,stroke:none,color:#334155,font-weight:bold;

  GEXInput("GEX counts and metadata<br/>(aggregated_counts + metadata.GEX)")
  ATACInput("ATAC peak matrix and metadata<br/>(peak_QC_filtered_BPCells_matrix.ATAC)")
  GEXEmbedding("GEX PCA and Harmony<br/>(harmony_embeddings_matrix.GEX)")
  ATACEmbedding("ATAC LSI and Harmony<br/>(harmony_embeddings_matrix.ATAC)")
  SingleModalityUMAPs("GEX and ATAC UMAPs<br/>(UMAP_embeddings_tibble.GEX/ATAC)")
  WNNEmbedding("Weighted nearest-neighbor graph<br/>(WNN_results)")
  WNNMetadata("Integrated cell metadata<br/>(metadata_w_cell_types_tibble.WNN)")
  WNNOutputs("Integrated UMAP and QC outputs<br/>(WNN UMAP plots)")

  GEXInput -->|PCA + Harmony| GEXEmbedding
  ATACInput -->|LSI + Harmony| ATACEmbedding
  GEXEmbedding -->|UMAP + diagnostics| SingleModalityUMAPs
  ATACEmbedding -->|UMAP + diagnostics| SingleModalityUMAPs
  GEXEmbedding -->|combine embeddings| WNNEmbedding
  ATACEmbedding -->|combine embeddings| WNNEmbedding
  WNNEmbedding -->|clusters + cell types| WNNMetadata
  WNNMetadata -->|integrated visualization| WNNOutputs

  class GEXInput,ATACInput regular_input;
  class GEXEmbedding,ATACEmbedding,WNNEmbedding intermediate_object;
  class SingleModalityUMAPs,WNNMetadata regular_output;
  class WNNOutputs QC_output;
