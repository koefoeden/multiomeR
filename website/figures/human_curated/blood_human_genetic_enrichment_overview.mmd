  GeneticInputs("ATAC activity and metadata<br/>(chromVAR + pseudobulk ATAC)")
  GWASInputs("GWAS and Open Targets inputs<br/>(GWAS_inputs_tibble)")
  PeakWeights("Variant-to-peak weights<br/>(GWAS chromVAR weights)")
  SingleCellGWAS("Single-cell GWAS chromVAR scores<br/>(GWAS_chromVAR_ZScore_records)")
  PseudobulkGWAS("Pseudobulk GWAS chromVAR models<br/>(psbulk_GWAS_chromVAR)")
  GeneChromVAR("Gene-linked GWAS chromVAR models<br/>(psbulk_GWAS_gene_chromVAR)")
  SCAVENGE("SCAVENGE trait relevance<br/>(SCAVENGE_TRS_tibbles)")
  GeneticOutputs("Genetic enrichment reports<br/>(summary plots)")

  GWASInputs -->|weight variants| PeakWeights
  GeneticInputs -->|score cells| SingleCellGWAS
  PeakWeights -->|apply peak weights| SingleCellGWAS
  GeneticInputs -->|aggregate activity| PseudobulkGWAS
  PeakWeights -->|fit weighted models| PseudobulkGWAS
  PeakWeights -->|gene-linked weighting| GeneChromVAR
  SingleCellGWAS -->|trait scores| SCAVENGE
  SingleCellGWAS -->|summaries| GeneticOutputs
  PseudobulkGWAS -->|model reports| GeneticOutputs
  GeneChromVAR -->|locus reports| GeneticOutputs
  SCAVENGE -->|TRS plots| GeneticOutputs

  class GeneticInputs,GWASInputs regular_input;
  class PeakWeights intermediate_object;
  class SingleCellGWAS,PseudobulkGWAS,GeneChromVAR,SCAVENGE regular_output;
  class GeneticOutputs QC_output;
